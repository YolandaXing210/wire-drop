<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <!--
    Compiled from source rather than referenced: these two files are deliberately free of
    Grasshopper types, so the tests run without a Rhino install to load assemblies from.
  -->
  <ItemGroup>
    <Compile Include="../../src/WireDrop/Ranking/TypeCompat.cs" />
    <Compile Include="../../src/WireDrop/Ranking/Fuzzy.cs" />
    <Compile Include="../../src/WireDrop/Ranking/CategoryOrder.cs" />
    <Compile Include="../../src/WireDrop/Ranking/SliderText.cs" />
    <Compile Include="../../src/WireDrop/Ranking/ShortcutMap.cs" />
    <Compile Include="../../src/WireDrop/UI/KeyMap.cs" />
    <Compile Include="../../src/WireDrop/UI/LayoutMetrics.cs" />
    <Compile Include="../../src/WireDrop/UI/ChipFlow.cs" />
    <Compile Include="../../src/WireDrop/UI/StickyHeader.cs" />
    <Compile Include="../../src/WireDrop/UI/ScrollBar.cs" />
  </ItemGroup>
</Project>
